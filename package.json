{
  "name": "toymate",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun run build:backend && bun run build:frontend",
    "build:backend": "bun build src/backend.ts --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.ts --outfile dist/frontend.js --target browser",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test --pass-with-no-tests",
    "sync:repos": "sh scripts/sync-repos.sh",
    "check:dist": "bun run build && git diff --exit-code --stat -- dist",
    "bump": "bun scripts/bump-version.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "buttplug": "5.0.2",
    "lumiverse-spindle-types": "0.6.81",
    "typescript": "7.0.2"
  }
}
